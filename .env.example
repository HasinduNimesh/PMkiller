# Neon on Vercel — use the **pooled** host (-pooler) for the app.
# Append sslmode + longer timeouts so cold starts don't fail Prisma's default 5s.
#
# Neon → Connect → enable "Connection pooling", then append params if missing:
# ?sslmode=require&pgbouncer=true&connect_timeout=15&pool_timeout=15
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require&pgbouncer=true&connect_timeout=15&pool_timeout=15"

# Auth.js — REQUIRED in production (MissingSecret → 500 on /api/auth/*)
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Public site URL (no trailing slash). On Vercel you can omit this
# (host is inferred), but if set it MUST match the live domain, e.g.:
# AUTH_URL="https://pmkiller.vercel.app"
AUTH_URL="http://localhost:3000"

# GitHub OAuth App (https://github.com/settings/developers) — optional
# Callback: https://YOUR_DOMAIN/api/github/oauth/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
